# Secret do webhook da Revi — enviado no header x-revi-secret.
# Sem ele, as chamadas continuam funcionando, mas limitadas a 60 por minuto.
# Configure no Vercel: Settings > Environment Variables (nunca comite o valor real).
REVI_WEBHOOK_SECRET=

# Opcional: sobrescreve a URL do webhook (o padrão está em api/lead.js)
REVI_WEBHOOK_URL=
